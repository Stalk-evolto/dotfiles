可以使用 assoc-ref 访问 alist

#+begin_src scheme
  (assoc-ref %build-inputs "meson")
#+end_src

#+begin_example
$1 = "/gnu/store/a5486v6zy33hcqrsx0d906qwxkxnldxp-meson-1.9.0"
#+end_example

- %outputs 将 derivation 的 outputs 推导到 store item 名称默认输出为 out
- %build-inputs 将 derivation 的 inputs 推导到 store item 名称

现在我们将 sexp-builder 变成 derivation ，并加以说明 "glib" 是 glib-drv ，最后使用 build-expression->derivation 将 sexp 构建

#+begin_src scheme
  (use-modules (guix derivations)
               (guix packages)
               (guix store)
               (gnu packages guile)
               (gnu packages glib))

  (with-store store
    (let ((guile-3.0-drv (package-derivation store guile-3.0))
          (glib-drv (package-derivation store glib)))
      (build-expression->derivation store "glib-symlink" sexp-builder
                                    #:guile-for-build guile-3.0-drv
                                    #:inputs `(("glib" ,glib-drv)))))
#+end_src

#+begin_example
warning: 'build-expression->derivation' is deprecated, use 'gexp->derivation' instead
$2 = #<derivation /gnu/store/whrai76416xyk0bqp80dhpr4pm2xza8h-glib-symlink.drv => /gnu/store/8h2p2w7nnhnx8n9g3inamly76504j62c-glib-symlink 7f48b8f70cd0>
#+end_example

这里提示 build-expression->derivation 不再推荐使用，我们可以注意到以下问题

- #:inputs ，必须是 derivations ，所以需要事先使用 package-derivation 将 glib 的 package define 转变成 derivation
- #:guile-for-build 没有默认值，还需要填入构建需要使用的 guile 的 derivation
- build-expression->derivation 和 package-derivation 不是 monadic ，没有 monad 统一处理输入输出，不直观

S-Expressions 的构建方式问题很多， G-Expressions 用于解决这些问题

** 前置条件

G-Expressions 本质上是一种 record 类型 <gexp>

#+begin_src scheme
  (define-record-type <gexp>
    (make-gexp references modules extensions proc location)
    gexp?
    (references gexp-references)                    ;list of <gexp-input>
    (modules    gexp-self-modules)                  ;list of module names
    (extensions gexp-self-extensions)               ;list of lowerable things
    (proc       gexp-proc)                          ;procedure
    (location   %gexp-location))
#+end_src

最重要的两个属性是

- proc 一个 procedure 返回相应的 S-Expression
- references G-Expressions 需要用到的 input ，储存在 <gexp-input> 中

示例 sexp-builder 的 G-Expressions 版本

#+begin_src scheme
  (use-modules (guix gexp)
               (gnu packages glib))

  (define gexp-builder
    #~(symlink #$(file-append glib "/bin/glib")
               #$output))
#+end_src

这更简洁，为了实现 G-Expressions 需要使用 #~ 语法，这是 gexp 的宏。 (注意与 S-Expressions quasiquote 的区分)

| G-Expressions     | G-Expressions                | S-Expressions | S-Expressions           |
|-------------------+------------------------------+---------------+-------------------------|
| #~exp             | (gexp exp)                   | `data         | (quasiquote data)       |
|-------------------+------------------------------+---------------+-------------------------|
| #$obj             | (ungexp obj)                 | ,expr         | (unquote expr)          |
| #$output[:output] | (ungexp obj output)          |               |                         |
| #+obj             | (ungexp-native obj)          |               |                         |
| #+obj:output      | (ungexp-native obj output)   |               |                         |
|-------------------+------------------------------+---------------+-------------------------|
| #$@lst            | (ungexp-splicing lst)        | ,@expr        | (unquote-splicing expr) |
| #+@lst            | (ungexp-native-splicing lst) |               |                         |

希望嵌入外部值为参考时，使用 #$ 或者 ungexp ，可以接受四种类型

- S-Expressions (string, list ...) 将字面值嵌入
- 其他 G-Expressions 字面值
- 返回值可以被 lowred 成一个 derivation 的表达式，例如 <package> ， 可以 out 到 store item ；
  如果表达式是可构建对象绑定的 symbol , 例如 (gnu pakcages glib) 里 define-public 定义的 package define ，则可以使用 package:lib ，
  但是不能使用 (get-package):lib
- output ，就像可构建对象绑定的 symbol 一样， output:out 嵌入 G-Expressions 构建的 derivation-outputs 的 out

#+begin_src scheme
  #~(list #$"foobar"                         ;s-expression
        #$#~(string-append "foo" "bar")    ;g-expression
        #$(file-append glib "/bin/irssi") ;buildable object (expression)
        #$glib:bin                         ;buildable object (symbol)
        #$output:out)                      ;output
#+end_src

#+begin_example
$3 = #<gexp (list #<gexp-input "foobar":out>
     #<gexp-input #<gexp (string-append "foo" "bar") 7feede4f5cf0>:out>
     #<gexp-input #<file-append #<package glib@2.86.0 gnu/packages/glib.scm:448 7feeee9e38f0> "/bin/irssi">:out>
     #<gexp-input #<package glib@2.86.0 gnu/packages/glib.scm:448 7feeee9e38f0>:bin>
     #<gexp-output out>) 7feede4f5cc0>
#+end_example

理解了 G-Expressions ，现在将 G-Expressions 转变成 derivation (这一过程被称为 lowering) ，使用 lower-gexp monadic 将 proc 和 references 结合生成 <lowered-gexp> record
它是 G-Expressions 到 derivation 的中间数据类型

#+begin_src scheme
  (define lowered-gexp-builder
    (with-store store
      (run-with-store store
        (lower-gexp gexp-builder))))

  (lowered-gexp-sexp lowered-gexp-builder)
#+end_src

#+begin_example
$4 = (symlink "/gnu/store/71ffz3bdgyg53ncyj7z7dykyax6vysv4-glib-2.86.0/bin/glib" ((@ (guile) getenv) "out"))
#+end_example

有了 $4 这个由 G-Expressions 编译而成的 S-Expressions ，即可写入 store 的构建脚本文件中，那么如何转换成 derivation 呢？
实际上没有用于 lowered 的 G-Expressions 转换成 derivation 的接口， 只有一个用于将常规的 G-Expressions 转换成 derivation 的工具，这工具最开始使用了 lower-gexp 然后实现上述内容内部转换，而不是将其外包给其他 procedure

不出所料，这个 procedure 被称为 gexp->derivation ，与 S-Expression (build-expression->derivation 和 monads 系统出现之后在 Guix 中被弃用的 procedure) 不同，这是个 monadic 。

#+begin_src scheme
  (with-store store
    (run-with-store store
      (gexp->derivation "glib-symlink" gexp-builder)))
#+end_src

#+begin_example
$5 = #<derivation /gnu/store/vpfy2gnihpdm0qp1p9kf3gk298qx2ygi-glib-symlink.drv => /gnu/store/lbiich3bxh0hlfb01mhr77d0pq0z3s75-glib-symlink 7feede1f90f0>
#+end_example

最后对比一下 S-Expressions 构建 derivation 的代码

#+begin_src scheme
  (use-modules (guix derivations)
               (guix packages)
               (guix store)
               (gnu packages guile)
               (gnu packages glib))

  (define sexp-builder
    `(let* ((out (assoc-ref %outputs "out"))
            (glib (assoc-ref %build-inputs "glib"))
            (bin/glib (string-append glib "/bin/glib")))
       (symlink bin/glib out)))

  (with-store store
    (let ((guile-3.0-drv (package-derivation store guile-3.0))
          (glib-drv (package-derivation store glib)))
      (build-expression->derivation store "glib-symlink" sexp-builder
                                    #:guile-for-build guile-3.0-drv
                                    #:inputs `(("glib" ,glib-drv)))))
#+end_src

这是 G-Expressions 的等价代码

#+begin_src scheme
  (use-modules (guix gexp)
               (guix store)
               (gnu packages glib))

  (define gexp-builder
    #~(symlink #$(file-append glib "/bin/glib")
               #$output))

  (with-store store
    (run-with-store store
      (gexp->derivation "glib-symlink" gexp-builder))
#+end_src

这虽然被高度抽象化了，但是为了更多的复杂的 packages define 和 services define ， G-Expressions 是救命稻草，你可以在 inputs 中像引用字符串那样引用 output 路径。
有时，你需要注意使用 ungexp-native (写作 #+) 比普通 ungexp 更可取的情况

偏离一下话题，如果你想要看到 <gexp> record 里面的东西，但是又不想构建任何东西，你可以使用 gexp->approximate-sexp procedure ，用虚拟值取代所有 reference

#+begin_src scheme
  (gexp->approximate-sexp gexp-builder)
#+end_src

#+begin_example
$6 = (symlink (*approximate*) (*approximate*))
#+end_example

** Lowerable-Object 基础设施

目前已经出现过两个可以转化成 derivation 的 record ，通常将这类 record 称为 lowerable object 或者 file-like objects

- <package> ，一个 Guix package define
- <file-append> ，使用 ungexp 时，包装另外的 lowerable object 并追加一个 string 后缀到 output 路径

还有更多可以使用的。在 monads 提供两个 procedure
- text-file name text [references]
  返回一个将 text 储存到 store 中文件名为 (string-append hash name) 的文件的绝对路径的 monadic ， references 是上述文件生成所需的 references 默认为空列表
- interned-file file [name] [#:recursive? #t] [#:select? (const #t)]
  返回内容为 file 的文件内容，名字为 (string-append hash name) 的文件的 store 绝对路径， recursive? 为 #t 时递归的将子目录一起复制到 store ，如果 recursive? 为 #t ，递归运行 (select? file stat) 其中 file 时文件的绝对路径， stat 时 lstat 的结果

不过这些 procedure 在 G-Expressions 中并不好用，需要在 ungexp 时将其包裹在 (with-store store (run-with-store store ...)) 中，这相当乏味
值得庆幸的是，在 (guix gexp) 提供 plain-file 和 local-file 来填补这块空白，示例

#+begin_src scheme
  (use-modules (guix monads)
               (guix store)
               (guix gexp)
               (guix derivation)
               (ice-9 ftw)
               (ice-9 textual-ports))

  (define (build-derivation monadic-drv)
    (with-store store
      (run-with-store store
        (mlet* %store-monad ((drv monadic-drv))
          (mbegin %store-monad
            ;; BUILT-DERIVATIONS is the monadic version of BUILD-DERIVATIONS.
            (built-derivations (list drv))
            (return (derivation-output-path
                     (assoc-ref (derivation-outputs drv) "out"))))))))

  (define world-greeting-output
    (build-derivation
     (gexp->derivation "world-greeting"
                       #~(begin
                           (mkdir #$output)
                           (symlink #$(plain-file "hi-world"
                                                  "Hi, world!")
                                    (string-append #$output "/hi"))
                           (symlink #$(plain-file "hello-world"
                                                  "Hello, world!")
                                    (string-append #$output "/hello"))
                           (symlink #$(plain-file "greetings-world"
                                                  "Greetings, world!")
                                    (string-append #$output "/greetings"))))))

  ;; We turn the list into multiple values using (APPLY VALUES …).
  (apply values
         (map (lambda (file-path)
                (let* ((path (string-append world-greeting-output "/" file-path))
                       (contents (call-with-input-file path get-string-all)))
                  (list path contents)))
              ;; SCANDIR from (ICE-9 FTW) returns the list of all files in a
              ;; directory (including ``.'' and ``..'', so we remove them with the
              ;; second argument, SELECT?, which specifies a predicate).
              (scandir world-greeting-output
                       (lambda (path)
                         (not (or (string=? path ".")
                                  (string=? path "..")))))))
#+end_src

#+begin_example
$1 = ("/gnu/store/0vcfpisy9hg17kxyvkib8gnxxmj0wmhg-world-greeting/greetings" "Greetings, world!")
$2 = ("/gnu/store/0vcfpisy9hg17kxyvkib8gnxxmj0wmhg-world-greeting/hello" "Hello, world!")
$3 = ("/gnu/store/0vcfpisy9hg17kxyvkib8gnxxmj0wmhg-world-greeting/hi" "Hi, world!")
#+end_example

注意，为了构建输出这里定义了一个 procedure ；下面将需要风格非常相似地构建 derivation ，所以让 world-greeting-output 重复使用而不是复制代码

在 gexp 库中，还有许多有用的模块。包括
- computed-file
- program-file
- mixed-file

那么，你可能在想这一点：有如此之多的 lowerable objects 被包括在 G-Expressions 库中，肯定有办法进一步定义， define-gexp-compiler 宏是我们需要的

define-gexp-compiler 的基本用法是，创建一个 procedure 它的参数是一个 lower record, host system, target system ，返回一个 derivation 或者 store item 在 %store-monad 的 monadic 里

我们先尝试创建一个 lowerable object

#+begin_src scheme
  (use-modules (srfi srfi-9))

  (define-record-type <greeting-file>
    (greeting-file greeting)
    greeting?
    (greeting greeting-file-greeting))
#+end_src

现在使用 define-gexp-compiler 将 lower-object 编译成 store item 或者 derivation
lower-object 就是为了正确的使用 gexp-compiler 的 object 的 procedure

#+begin_src scheme
  (use-modules (ice-9 i18n))

  (define-gexp-compiler (greeting-file-compiler
                         (greeting-file <greeting-file>)
                         system target)
    (lower-object
     (let ((greeting (greeting-file-greeting greeting-file)))
       (plain-file (string-append greeting "-greeting")
                   (string-append (string-locale-titlecase greeting) ", world!")))))
#+end_src

#+begin_example
$4 = #<<gexp-compiler> type: #<record-type <greeting-file>> lower: #<procedure 18a6d18 at <unknown port>:273:0 (greeting-file system target)> expand: #<procedure default-expander (thing obj output)>>
#+end_example

现在重写使用 <greeting-file> 的示例

#+begin_src scheme
  (define world-greeting-2-output
    (build-derivation
     (gexp->derivation "world-greeting-2"
                       #~(begin
                           (mkdir #$output)
                           (symlink #$(greeting-file "hi")
                                    (string-append #$output "/hi"))
                           (symlink #$(greeting-file "hello")
                                    (string-append #$output "/hello"))
                           (symlink #$(greeting-file "greetings")
                                    (string-append #$output "/greetings"))))))

  (apply values
         (map (lambda (file-path)
                (let* ((path (string-append world-greeting-2-output
                                            "/" file-path))
                       (contents (call-with-input-file path get-string-all)))
                  (list path contents)))
              (scandir world-greeting-2-output
                       (lambda (path)
                         (not (or (string=? path ".")
                                  (string=? path "..")))))))
#+end_src

#+begin_example
$5 = ("/gnu/store/glwksy3nrbqs270c0pkq7npd8y4w3grr-world-greeting-2/greetings" "Greetings, world!")
$6 = ("/gnu/store/glwksy3nrbqs270c0pkq7npd8y4w3grr-world-greeting-2/hello" "Hello, world!")
$7 = ("/gnu/store/glwksy3nrbqs270c0pkq7npd8y4w3grr-world-greeting-2/hi" "Hi, world!")
#+end_example

这个例子可能不够复杂，你可能觉得不值得编写一个新的 gexp-compiler ，你可能注意到了这个输出

#+begin_example
$4 = #<<gexp-compiler>
        type: #<record-type <greeting-file>>
        lower: #<procedure 18a6d18 at <unknown port>:273:0 (greeting-file system target)>
        expand: #<procedure default-expander (thing obj output)>>
#+end_example

type 和 lower 是显而易见的，但是 expand 是什么？ 如果你注意到 file-append ，你可能会意识到，由 gexp-compiler 生成的用于嵌入到 G-Expressions 中的文本并不一定是所生成的 derivation 的精确 output 路径。

这里还有另一种方式编写 define-gexp-compiler 允许你同时指定 lowering procedure 编译成的 derivation 或者 store item ；以及 expanding procedure 扩展成 text

首先创建一个新的 lowerable object ；这是一个构建 Guile package 和 expand 它的 module 目录的 record

#+begin_src scheme
  (define-record-type <module-directory>
    (module-directory package)
    module-directory?
    (package module-directory-package))
#+end_src

现在同时定义一个 compiler 和 expander 为了 <module-directory> record

#+begin_src scheme
  (use-modules (gnu packages guile)
               (guix packages)
               (guix utils))

  (define lookup-expander (@@ (guix gexp) lookup-expander))

  (define-gexp-compiler module-directory-compiler <module-directory>
    compiler => (lambda (obj system target)
                  (let ((package (module-directory-package obj)))
                    (lower-object package system #:target target)))
    expander => (lambda (obj drv output)
                  (let* ((package (module-directory-package obj))
                         (expander (or (lookup-expander package)
                                       (lookup-expander drv)))
                         (out (expander package drv output))
                         (guile (or (lookup-package-input package "guile")
                                    guile-3.0))
                         (version (version-major+minor
                                   (package-version guile))))
                    (string-append out "/share/guile/site/" version))))
#+end_src

#+begin_example
$5 = #<<gexp-compiler> type: #<record-type <module-directory>> lower: #<procedure 1c5df68 at <unknown port>:435:16 (obj system target)> expand: #<procedure 1c5df78 at <unknown port>:438:16 (obj drv output)>>
#+end_example

让我们输出它

#+begin_src scheme
  (use-modules (gnu packages guile-xyz))

  (define module-directory-output/guile-webutils
    (build-derivation
     (gexp->derivation "module-directory-output"
                       #~(symlink #$(module-directory guile-webutils) #$output))))
#+end_src

#+begin_src scheme
  (readlink module-directory-output/guile-webutils)
#+end_src

#+begin_example
$6 = "/gnu/store/by79i9wm0igai3birq5scx1jdin0awx8-guile-webutils-0.1-1.d309d65/share/guile/site/3.0"
#+end_example

#+begin_src scheme
  (scandir module-directory-output/guile-webutils)
#+end_src

#+begin_example
$7 = ("." ".." "webutils")
#+end_example

#+begin_src scheme
  (define module-directory-output/guile2.2-webutils
    (build-derivation
     (gexp->derivation "module-directory-output"
                       #~(symlink #$(module-directory guile2.2-webutils) #$output))))
#+end_src

#+begin_src scheme
  (readlink module-directory-output/guile2.2-webutils)
#+end_src

#+begin_example
$8 = "/gnu/store/837rndx2v0pb1qmlwp2qcwsqh4kh79ik-guile2.2-webutils-0.1-1.d309d65/share/guile/site/2.2"
#+end_example

#+begin_src scheme
  (scandir module-directory-output/guile2.2-webutils)
#+end_src

#+begin_example
$9 = ("." ".." "webutils")
#+end_example

谁知道你为什么想做这件事,但确实有效!我们已经研究了为什么需要G表达式、它们的工作原理以及如何扩展它们,现在我们只有两个更先进的功能可供使用:跨平台构建支持和模块。

** 导入外部模块

* Function Programming
函数式编程是 Alonzo Church 的思想实践，
*** lambda ，是函数式编程的基本单元，一切进入 lambda 的变量都不再可变，所以相同的输入会得到相同的输出
*** 高阶函数，接受函数用于改变功能的函数
*** currying，能够返回已经传入部分参数的函数，可以逐步传入参数
*** 惰性评估，仅仅在需要时才执行代码，而不是定义时执行
**** 抽象控制结构，如果 condition 为 #f ，则 condition 与 body 永远不会评估
**** 无限数据结构，由于需要才会被评估，无限的数据结构只在我们取出部分的时候评估取出的部分
*** 顺序评估的方式
**** continuation 同上 call-with-current-continuation
**** 模式匹配，将部分分支拆分成定义，如果需要修改分支行为不用进入庞大的分支结构
**** 闭包，在函数里定义的函数，同一个闭包的相同特点是都拥有同一个父函数

* Foreign Function Interface

有时候你需要使用 C 或者 Rust 或者其他不是 scheme 语言的动态链接库，而现在的 Guile Reference 3.0 里只介绍了新式写法，而一些 Guile Scheme 项目仍然使用着 guile 2.0 旧式写法，例如 guile-git, shepherd 等。

** 将 libc 转变成 scheme procedure 的写法

*** guile 2.0 的 Foreign Function Interface 写法
#+begin_src scheme
  (define (libc->procedure return name params)
    (catch #t
      (lambda ()
        (let ((ptr (dynamic-func name (dynamic-link))))
          (pointer->procedure return ptr params)))
      (lambda args
        (lambda _
          (throw 'system-error name  "~A" (list (strerror ENOSYS))
                 (list ENOSYS))))))
#+end_src
*** guile 3.0 的等价写法
#+begin_src scheme
  (use-modules (system foreign-library))

  (define (libc->procedure return name params)
    (catch #t
      (lambda ()
        (let ((ptr (foreign-library-pointer (load-foreign-library) name)))
          (pointer->procedure return ptr params)))
      (lambda args
        (lambda _
          (throw 'system-error name  "~A" (list (strerror ENOSYS))
                 (list ENOSYS))))))
#+end_src
*** guile 3.0 封装的 foreign-library-function 的等价写法
#+begin_src scheme
  (use-modules (system foreign-library))

  (define (libc->procedure return name params)
    (catch #t
      (lambda ()
        (foreign-library-function (load-foreign-library)
                                  name
                                  #:return-type return
                                  #:arg-types params))
      (lambda args
        (lambda _
          (throw 'system-error name  "~A" (list (strerror ENOSYS))
                 (list ENOSYS))))))
#+end_src
*** guile 3.0 封装的 with-exception-handler 和 raise-exception 的等价写法
#+begin_src scheme
  (use-modules (system foreign-library))

  (define (libc->procedure return name params)
    (with-exception-handler
        (lambda (exception)
          (lambda _
            (raise-exception
             (make-exception-from-throw 'system-error
                                        '(name "~A" (list (strerror ENOSYS)) (list ENOSYS))))))
      (lambda ()
        (foreign-library-function (load-foreign-library)
                                  name
                                  #:return-type return
                                  #:arg-types params))
      #:unwind? #t))
#+end_src

** 回归测试验证

为了验证以上例子，可以写一个测试用例检验其效果
#+begin_src scheme
  (use-modules (system foreign)
               (system foreign-library)
               (srfi srfi-1)
               (srfi srfi-64))

  (define (libc->procedure/guile2.0 return name params)
    (catch #t
      (lambda ()
        (let ((ptr (dynamic-func name (dynamic-link))))
          (pointer->procedure return ptr params)))
      (lambda args
        (lambda _
          (throw 'system-error name  "~A" (list (strerror ENOSYS))
                 (list ENOSYS))))))

  (define (libc->procedure/guile3.0 return name params)
    (catch #t
      (lambda ()
        (let ((ptr (foreign-library-pointer (load-foreign-library) name)))
          (pointer->procedure return ptr params)))
      (lambda args
        (lambda _
          (throw 'system-error name  "~A" (list (strerror ENOSYS))
                 (list ENOSYS))))))

  (define (libc->procedure/guile-current return name params)
    (catch #t
      (lambda ()
        (foreign-library-function (load-foreign-library)
                                  name
                                  #:return-type return
                                  #:arg-types params))
      (lambda args
        (lambda _
          (throw 'system-error name  "~A" (list (strerror ENOSYS))
                 (list ENOSYS))))))

  (define (libc->procedure return name params)
    (with-exception-handler
        (lambda (exception)
          (lambda _
            (raise-exception
             (make-exception-from-throw 'system-error
                                        '(name "~A" (list (strerror ENOSYS)) (list ENOSYS))))))
      (lambda ()
        (foreign-library-function (load-foreign-library)
                                  name
                                  #:return-type return
                                  #:arg-types params))
      #:unwind? #t))

  (define %foreign-function-interface
    (list libc->procedure/guile2.0
          libc->procedure/guile3.0
          libc->procedure/guile-current
          libc->procedure))

  (define %libc-functions-info
    (list (list int "abs" (list int))
          (list int "isalpha" (list int))
          (list int "isdigit" (list int))
          (list int "isupper" (list int))
          (list int "islower" (list int))))

  (define (all-equal? lst)
    (or (null? lst)
        (fold (lambda (x acc)
                (and acc (equal? x (car lst))))
              #t
              (cdr lst))))

  (test-begin "Foreign Function Interface")

  (test-assert "return equal"
    (every identity
           (let ((input (random 127)))
             (map (lambda (info)
                    (all-equal? (map (lambda (ffi) ((apply ffi info) input))
                                     %foreign-function-interface)))
                  %libc-functions-info))))

  (test-end "Foreign Function Interface")
#+end_src
